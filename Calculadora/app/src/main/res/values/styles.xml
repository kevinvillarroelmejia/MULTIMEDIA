<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--  todos los botones heredan de aquii -->
    <style name="Widget.Calculadora.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_background</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>




    <!-- los numeros   y punto -->
    <style name="Widget.Calculadora.Button.Number">
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Operadoraciones basicas -->
    <style name="Widget.Calculadora.Button.Operator">
        <item name="android:textSize">32sp</item>
        <item name="backgroundTint">@color/button_operator</item>
    </style>

    <!-- acciones especiales: C o DEL -->
    <style name="Widget.Calculadora.Button.Special">
        <item name="android:textSize">20sp</item>
        <item name="backgroundTint">@color/button_special</item>
        <item name="android:textColor">@color/text_button_light</item>
    </style>




    <!-- el boton del = -->
    <style name="Widget.Calculadora.Button.Equals">
        <item name="android:textSize">32sp</item>
        <item name="backgroundTint">@color/button_equals</item>
        <item name="android:textColor">@color/text_button_light</item>
    </style>

    <!-- Pantalla secundaria expresion en curso -->
    <style name="Widget.Calculadora.Text.Expression" parent="">
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/text_expression</item>
        <item name="android:gravity">end|bottom</item>
        <item name="android:maxLines">1</item>
    </style>




    <!-- pantalla principal del resultado -->
    <style name="Widget.Calculadora.Text.Result" parent="">
        <item name="android:textColor">@color/text_result</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">24sp</item>
        <item name="autoSizeMaxTextSize">96sp</item>
        <item name="autoSizeStepGranularity">2sp</item>
    </style>

</resources>